# teamtaika.com — required environment variables (DOCUMENTATION ONLY).
# Real values are configured in the Netlify UI (Site settings → Environment variables),
# scoped to the Production deploy context. NEVER put real secrets in this file or the repo.
# All values below are placeholders.

# --- Supabase (client/admin portal) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — SERVER-SIDE ONLY (Netlify Functions). Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# --- Stripe (checkout + webhook) ---
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Optional: set to "true" to enable Stripe automatic tax on checkout sessions.
STRIPE_AUTOMATIC_TAX=false

# --- Resend (transactional email / notifications) ---
RESEND_API_KEY=re_REPLACE_ME

# --- Google Cloud Translation (portal translate preview) ---
GOOGLE_TRANSLATE_API_KEY=REPLACE_ME

# --- Misc ---
# Canonical site origin used to build absolute return/success URLs.
SITE_ORIGIN=https://teamtaika.com
# Comma-separated recipients for the weekly Netlify form-submission digest.
DIGEST_TO=projects@taikatranslations.com,sales@taikatranslations.com,ceo@taikatranslations.com
